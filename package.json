INSERT INTO public.rts_posts (id, title, slug, excerpt, body, cover_image, author, category, published_at, created_at) VALUES
  ('a835b234-a6c0-4031-8cdd-a121b9edae4b', 'RTS Regatta 2024 Raises Record Funds', 'regatta-2024-record-funds', 'The annual RTS Regatta returned bigger than ever, with sailors and sponsors helping raise a record sum for local causes.', 'The 2024 edition of the Round Table Seychelles Regatta was our most successful yet. Held under clear blue skies off the coast of Mahe, dozens of boats took to the water in a spirited day of racing and fellowship.\n\nThanks to the generosity of our sponsors, participants and the wider community, we raised a record amount that will go directly toward education and marine conservation projects across the islands.\n\nWe extend our heartfelt thanks to every volunteer, sailor and supporter who made the day possible. Plans are already underway for an even bigger Regatta next year.', 'https://d64gsuwffb70l.cloudfront.net/6a1d49a1cf6c2dfcce9d772e_1781077004723_20e8e21b.png', 'RTS Communications', 'Events', '2026-06-07 07:48:48.79993+00', '2026-06-10 07:48:48.79993+00'),
  ('8a4ea2dd-68a3-4420-aee9-78956c13e718', 'Beach Cleanup Drive Restores Twelve Coastlines', 'beach-cleanup-twelve-coastlines', 'Our monthly cleanup initiative reached a major milestone, with twelve beaches now restored to their natural beauty.', 'Protecting the pristine coastlines of Seychelles is at the heart of what we do. Over the past year, RTS volunteers have dedicated countless weekends to removing waste and educating the public about marine pollution.\n\nThis month we proudly celebrated the restoration of our twelfth beach. Every cleanup not only beautifies our shores but also protects the marine life that depends on healthy ecosystems.\n\nWant to join the next cleanup? Get in touch with us and become part of the movement.', 'https://d64gsuwffb70l.cloudfront.net/6a1d49a1cf6c2dfcce9d772e_1781076892876_5ecbf93a.jpg', 'Projects Committee', 'Projects', '2026-05-31 07:48:48.79993+00', '2026-06-10 07:48:48.79993+00'),
  ('82fe6570-f0a9-4358-bfa1-1b9eee7e4269', 'New Youth Mentorship Programme Launching Soon', 'youth-mentorship-launch', 'RTS announces an exciting new initiative connecting young Seychellois with experienced professional mentors.', 'We are thrilled to announce the upcoming launch of our Youth Mentorship Initiative. Set to begin in Q2 2025, the programme will pair young people with experienced mentors from a range of professions.\n\nParticipants will receive guidance on leadership, career development and personal growth, while building lasting relationships with role models in their community.\n\nApplications for both mentors and mentees will open shortly. Stay tuned for more details.', 'https://d64gsuwffb70l.cloudfront.net/6a1d49a1cf6c2dfcce9d772e_1781077156276_f90e6068.jpg', 'Membership Office', 'Announcements', '2026-05-21 07:48:48.79993+00', '2026-06-10 07:48:48.79993+00'),
  ('55102b39-8afb-4d26-b5b2-2c479db422c8', 'Reforestation Programme Plants 5,000th Tree', 'reforestation-5000-trees', 'A landmark moment for our environmental efforts as the reforestation programme reaches a major planting milestone.', 'Our ongoing reforestation programme has reached an incredible milestone: 5,000 native trees planted across the islands.\n\nThese trees help combat soil erosion, restore habitats and preserve the unique biodiversity that makes Seychelles so special. The effort has brought together members, schools and local communities in a shared mission.\n\nWe are grateful to everyone who has dug, planted and watered alongside us. Here is to the next 5,000.', 'https://d64gsuwffb70l.cloudfront.net/6a1d49a1cf6c2dfcce9d772e_1781077137241_48860eac.jpg', 'Projects Committee', 'Projects', '2026-05-09 07:48:48.79993+00', '2026-06-10 07:48:48.79993+00');

